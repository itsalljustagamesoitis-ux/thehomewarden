---
import BaseLayout from '@platform/core/src/layouts/BaseLayout.astro'
import { getSiteConfig } from '@platform/core/src/lib/config'

const cfg = getSiteConfig()
---

<BaseLayout
  title={`Affiliate Disclosure — ${cfg.site.brand_name}`}
  description={`How ${cfg.site.brand_name} uses affiliate links and earns from qualifying purchases.`}
>
  <div class="container" style="padding: 3rem 1.5rem; max-width: 720px;">
    <h1>Affiliate Disclosure</h1>
    <p>
      {cfg.site.brand_name} participates in the Amazon Services LLC Associates Program, an affiliate
      advertising program designed to provide a means for sites to earn advertising fees by advertising
      and linking to Amazon.com. We may also take part in other affiliate programmes, including those run
      through the Awin and CJ (Commission Junction) networks, so some links to merchants may be network
      affiliate links.
    </p>
    <p>
      When you click one of these links and make a purchase, we may receive a small commission at no
      additional cost to you. Affiliate links are marked as sponsored. Commissions help keep the site running.
    </p>
    <p>
      The guides on this site are compiled from manufacturer specifications, current product listings and
      published research, and this site does not test products. We earn a commission only when a purchase
      is made through a link, so please read the guides as shopping research to help you compare options,
      not as independent product testing.
    </p>
    <p>
      If you have any questions about our affiliate relationships, please <a href="/contact/">contact us</a>.
    </p>
  </div>
</BaseLayout>
